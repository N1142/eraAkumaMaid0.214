		PRINTFORML %TEXTR("阴部/阴道/小穴/那里")%用的新振動棒什么的…」
	ELSEIF COND("身嗜み：Ａ拡張")
		PRINTFORML %TEXTR("肛門/屁股那边/不浄的穴")%用的……肛用%TEXTR("肛塞/拉珠/振動棒")%之类的……」
	ELSEIF COND("身嗜み：尿道拡張")
		PRINTFORML 尿道专用的新导尿管之类的……需要吗？」
	ELSE
		PRINTFORML 新的%TEXTR("衣装/内衣")%什么的……可能想要吧」
	ENDIF
CASE "购物終了"
	;胖次没収中
	IF COND("買い物胖次没収中")
		PRINTFORMW 「%TEXTR(@"……对于%CNAME("二人称")%的所作所为有好多话想说呢。万一败露的话您打算怎么办啊？/%CNAME("一人称")%紧张得快要死掉啦。下次请不要再做这种恶作剧了好吗？")%」
	;なにも買わなかった
	ELSEIF COND("買上品数") == 0
		PRINTFORMW 「%TEXTR("也是呢。就算不在店里买如今也有网购嘛/真的不买也没関系吗？　过后再让弗理希艾尔小姐去买可不好哟")%」
	ELSEIF CHECK_CLO("泳装姿") || CHECK_CLO("体操服姿")
		IF TALENT:淫乱 && ABL:露出癖 >= 3
			PRINTFORML 「有点惊险啊。 虽然很不好意思……那个…………」
			PRINTFORMW 「我并不讨厌……如果下次还再这样命令我的话，也可以哦？」
		ELSE
			PRINTFORMW 「呼…………」
		ENDIF
	ELSEIF CHECK_CLO("内衣姿") || CHECK_CLO("裸体")
		IF TALENT:淫乱 && ABL:露出癖 >= 3
			PRINTFORML 「%TEXTR(@"居然做了这么丢脸的事……圣职者失格了呢。之后请神听%CNAME("一人称")%的忏悔/明明很害羞……但是却心跳不已之类的。这样会被神明责罚的呀")%」
			PRINTFORMW 「……%TEXTR(@"才不是。%CNAME("一人称")%只是不得不执行命令……绝对不是变态啊/竟然因为露出而兴奋……不是的，这个、这个……只是因为太害羞所以湿了而已")%」
		ELSE
			PRINTFORM 「真是的，感到開心的只有%CNAME("二人称")%一个人哦
			IF TALENT:恋慕
				PRINTFORM 。%TEXTR("在只有两人独处的场所还好，但在店里会给其他人造成困扰的，所以不行哟？/要是想做那种事情的话……就去没有其他人的深夜的公园之类的地方做吧")%
			ENDIF
			PRINTFORMW 」
		ENDIF
	ELSE
		PRINTFORMW 「可以的话，我帮你提袋子吧？」
	ENDIF
