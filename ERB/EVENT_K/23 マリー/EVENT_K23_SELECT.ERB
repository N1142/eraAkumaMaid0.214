	STR:選択肢 += "要求和指导者接吻/"

IF TALENT:恋慕 && TALENT:淫乱 && ABL:受虐属性 >= 5 && ABL:露出癖 >= 5 && CEVENT("事件：性的款待／玛丽") == 0
	SIF COND("身嗜み：Ｖ拡張")
		STR:選択肢 += "远程操控振動棒/"
	SIF COND("身嗜み：Ａ拡張")
		STR:選択肢 += "观察Ａ肛塞/"
	SIF TALENT:巨乳 && TALENT:乳环 && CHECK_CLO("乳頭露出")
		STR:選択肢 += "乳环鑑賞/"
;	SIF COND("黑木耳") && TALENT:陰唇環 && CHECK_CLO("大陰唇露出")
;		STR:選択肢 += "陰唇環鑑賞/"
