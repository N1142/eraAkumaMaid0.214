;-------------------------------------------------
;お願い・交易での選択肢を追加。番号は80～89を使ってよい
@WISH_K23_ADDSELECT
SIF CEVENT("換装：玛丽") && COND("調教中") == 0
	STR:選択肢 = %STR:選択肢% [80] %TEXT_LJ("着替えてもらう", 16)% … %NAME:TARGET%に服装を変更してもらいます/
SIF TALENT:恋慕 && COND("調教中") == 0 && MONEY >= 50000
	STR:選択肢 = %STR:選択肢% [81] %TEXT_LJ("教会に寄付する", 16)% … %MONEY_C(50000)%を教会に寄付します/
SIF TALENT:恋慕 && COND("調教中") == 0 && BASE:MASTER:魂 >= 100 && ASSI > 0 && TARGET != ASSI
	STR:選択肢 = %STR:選択肢% [82] %TEXT_LJ("相性を改善して", 16)% … %NAME:TARGET%に%CALLNAME:ASSI%と仲良くなってもらいます/
;SIF  TALENT:恋慕 && COND("調教中") == 0 && BASE:MASTER:魂 >= 100 && CHARA_NUM("室内の邪魔者") > 0
;	STR:選択肢 = %STR:選択肢% [83] %TEXT_LJ("相性を改善して2", 16)% … %NAME:TARGET%に%CALLNAME:ASSI%と仲良くなってもらいます/

;お願い・交易で増やした選択肢の地の文と台詞
@KOJO_WISH_K23_ADDSELECT, ARGS
#DIM PAY_SOUL
#DIM LCOUNT
#DIM LCOUNT2
#DIM 候補数

SELECTCASE ARGS
CASE "着替えてもらう"
	CALL KISEKAE
CASE "教会に寄付する"
	MONEY -= 50000
	PRINTFORMW %CALLNAME:MASTER%向%CALLNAME:TARGET%所在的教会捐赠了%MONEY_C(50000)%。
	PRINTL 
	;PRINTFORML －玛丽－
	PRINTFORML 「%TEXTR(@"非常感谢。%CNAME("二人称")%的份%CNAME("一人称")%也会代为祈祷的/%CNAME("二人称")%终于開始觉醒信仰了呢/%CNAME("二人称")%的善行神明都看在眼里/%CNAME("一人称")%代神明向%CNAME("二人称")%传达感谢之情。真是万分感激")%」
	PRINTFORMW 「%TEXTR(@"当%CNAME("二人称")%真正觉醒对神的信仰时，定会悔改与恶魔的契约吧/积德行善的话，%CNAME("二人称")%也会有福报的哦/让我们从点滴小事開始日行一善吧。如果有驱魔仪式需求的话请随时告诉我")%」
	CFLAG:3302 += 1

;システムを組む為の暫定的な名前
CASE "相性を改善して"
	PRINTFORMW  以一单位魂为代价，和[%CSTR:称号%]%NAME:TARGET%做交易。
	PRINTFORML  【現在的%CALLNAME:MASTER%の魂：%TEXTS("0.01", BASE:MASTER:魂)%】
	PRINTFORML 
	PRINTFORML 「想要%CNAME("一人称")%跟%CNAME("助手")%搞好関系是吗？」
	PRINTFORM 【現在的%CALLNAME:TARGET%和%CALLNAME:ASSI%的相性：
	IF RELATION:(NO:ASSI) >= 200 && RELATION:ASSI:(NO:TARGET) >= 200
		;相性☆
		PRINTFORM 最高
	ELSEIF RELATION:(NO:ASSI) >= 150 && RELATION:ASSI:(NO:TARGET) >= 150
		;相性◎
		PRINTFORM 良好
	ELSEIF RELATION:(NO:ASSI) >= 120 && RELATION:ASSI:(NO:TARGET) >= 120
		;相性○
		PRINTFORM 还可以
	ELSEIF RELATION:(NO:ASSI) <= 80 && RELATION:ASSI:(NO:TARGET) <= 80
		;相性△　死に分岐のはず
		PRINTFORM 不太好
	ELSE
		;相性－
		PRINTFORM 普通
	ENDIF
	PRINTFORML 】
	PRINTFORML 
	CALL PRINT_SELECT, "是/否"
	IF RESULT == 0
		PAY_SOUL = 100
		;魂のやり取り
		CALL EXCHANGE_SOUL, "交易", PAY_SOUL, TARGET
		;相性+5　対象と助手
		CALL CHANGE_RELATION, 5, TARGET, ASSI
		PRINTFORML 
		IF RAND:2 == 0
			PRINTFORML 「为什么搞好関系也需要灵魂？是指这个问题吗」
			PRINTFORMW 「这可是商业机密哦」
		ELSEIF RAND:2 == 0
			PRINTFORML 「试着邀请%CNAME("助手")%一起训练吧」
			PRINTFORMW 「如果%CNAME("二人称")%想一起锻炼的话，请随时叫我哦」
			;PRINTFORMW （本音：三人の训练（意味深）シーンは描写されない）
		ELSE
			PRINTFORML 「已经和%("助手")%约好出去玩啦」
			PRINTFORMW 「去哪里先保密。话说%CNAME("二人称")%要一起来吗」
			;PRINTFORMW （本音：三人の约会シーンを描写するの面倒でしょう？）
		ENDIF
		PRINTFORML 
		PRINTFORMW %CALLNAME:TARGET%和%CALLNAME:ASSI%的関系变好了。
	ELSE
		PRINTFORML 「改变主意了吗」
		PRINTFORMW 「%CNAME("一人称")%随时欢迎%CNAME("二人称")%找我商量事情哦」
		RETURN 0
	ENDIF

ENDSELECT
