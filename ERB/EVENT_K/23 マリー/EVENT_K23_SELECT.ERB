ENDIF
IF CSTR:PREV_DAILYCOM == "托一托胸部" && TALENT:恋慕 && TALENT:巨乳 >= 2 && (CHARA_NUM("室内の邪魔者") == 0 || (TALENT:淫乱 && ABL:露出癖 >= 3 && CHARA_NUM("室内の邪魔者") >= 1) || (TALENT:淫乱 && ABL:露出癖 >= 5 && PLACE("野外"))) && (CHECK_CLO("乳頭露出") || CHECK_CLO("裸体") || CHECK_CLO("内衣姿") || CHECK_CLO("半脱可"))
