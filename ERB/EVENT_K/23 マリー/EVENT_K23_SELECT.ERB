;Talk指令の選択肢を追加
@DAILY1_K23_ADDSELECT
SIF TALENT:好色 || TALENT:淫乱 || ABL:欲望 >= 5
	STR:選択肢 += "Ｈ的话题/"
SIF (TALENT:恋慕 || TALENT:好色) && EQUIP:胖次 && COND("胖次色確認") == 0
	STR:選択肢 += "胖次の話/"

;Talk指令で増やした選択肢の地の文と台詞
@KOJO_DAILY1_K23_ADDSELECT, ARGS
SELECTCASE ARGS
CASE "Ｈ的话题"
	PRINTFORMW %CALLNAME:MASTER%做了%ARGS%。
	PRINTL 
	;PRINTFORML －玛丽－
	IF CEVENT("Ｈ的话题：初回／玛丽") == 0
		IF TALENT:恋慕
			PRINTFORMW 「请不要误会，%CNAME("一人称")%可是聖職者啊……」
			PRINTFORMW 「并不是喜欢H的事情……只是无法拒绝%CNAME("二人称")%的请求而已……」
			PRINTFORMW 「……只是…爱着%CNAME("二人称")%的缘故……只是爱着你而已……」
		ELSE
			PRINTFORML 「请不要误会，%CNAME("一人称")%可是聖職者啊……」
			PRINTFORMW 「并不是原谅了淫荡的行为。只是若人类与恶魔，能跨越性别平等相爱的话，倒也不是不能默许。」
		ENDIF
		CALL SET_CEVENT, "Ｈ的话题：初回／玛丽"
	ELSEIF (ABL:Ｖ拡張 >= 3 || ABL:Ａ拡張 >= 3) && RAND:3 == 0
		IF TALENT:淫乱 && (COND("身嗜み：Ｖ拡張") || COND("身嗜み：Ａ拡張")) && RAND:5 == 0
			PRINTFORML 「%CNAME("主人")%%TEXTR("好像忘记了/似乎误解了")%才要提前声明……」
			PRINTFORML 能够使用认知阻碍的只有%TEXTR("高位的悪魔/极其强大的魔术师/特殊女仆之类的/弗里希艾尔小姐")%哦」
			PRINTFORMW 「%CNAME("一人称")%是怎么蒙混过関的？……%TEXTR(@"这个嘛……是秘密哦/要说是因为每天虔诚祈祷……您觉得这个理由怎么样？/如果非要追问的话……还是别聊这个了吧/有些事不知道更好哟。就当没这回事好吗？/您不觉得有时候不靠魔术魔法，拼尽全力也能成事吗？/肌肉能让不可能变为可能……%CNAME("主人")%也来锻炼吧")%」
		ELSE
			PRINTFORML 「……%TEXTR("还想更多的/还要进一步")% 将\@ ABL:Ｖ拡張 >= 5 ? 小穴 # 肛門 \@%TEXTR("開発/拡張")%吗……如果是%CNAME("主人")% %TEXTR("想要的话。。/希望的话，我可以做哦")%……」
			IF RAND:2 == 0
				PRINTFORML 「……请好好的负起责任来。如果将来要在一起的话……」
				PRINTFORMW 「只要是%CNAME("主人")%所期望的事 ，无论是什么%CNAME("一人称")%都会接受的」
			ELSE
				PRINTFORML 「请答应我从今往后也会一直 一……直珍惜我哦……」
				PRINTFORMW 「因为%CNAME("一人称")%就是这么信任着%CNAME("二人称")%啊……」
			ENDIF
			;PRINTFORMW 恶魔女仆『呵呵，你说现在什么都可以做吗？』
		ENDIF
	ELSEIF (TALENT:常時Ｖ振動棒 && (ABL:Ｖ拡張 > TALENT:常時Ｖ振動棒)) || (TALENT:常時Ａ肛塞 && (ABL:Ａ拡張 > TALENT:常時Ａ肛塞))
		IF TALENT:常時Ｖ振動棒
			PRINTFORM 「……%TEXTR("振動棒/拡張")%
		ELSEIF TALENT:常時Ａ肛塞
			PRINTFORM 「……%TEXTR("塞子/肛塞")%
		ENDIF
		PRINTFORML 在%TEXTR("平时/日常")%不会在意吗？」
		PRINTFORMW 「这……%TEXTR("只要不去主动想它…就没関系/没问题的……别看我这样，但我也是驱魔人啊/努力不去在意就没有関系……")%」
		PRINTFORMW （……%TEXTR(@"多大尺寸什么的……说出来太害羞了/因为差不多已经完全习惯了……不好意思说出口/已经习……习惯了更大的尺寸什么的 %CNAME("一人称")%真的说不出口")%）
	ELSEIF ABL:受虐属性 >= 3 && RAND:2 == 0
		PRINTFORML 「……%TEXTR("在这种地方用言语欺负人是不行的……/不要那样坏心眼……")%」
		PRINTFORMW 「%TEXTR(@"即使是%CNAME("一人称")%……因为这个也变得更想要了呢……/虽然在忍耐了……但是忍耐一直有点辛苦……")%」
	ELSE
		PRINTFORMW 「……%TEXTR(@"真是的，两个人在做着怎样的PLAY……都被别人听到了啦/不行哦。%CNAME("一人称")%明明是圣职者……大家都能听到两个人在说什么")%」
	ENDIF
	PRINTL 
	PRINTFORMW %CALLNAME:TARGET%%TEXTR(@"面红耳炽地听着%CALLNAME:MASTER%的话/有点害臊并低着頭。")%
CASE "胖次の話"
	PRINTFORMW %CALLNAME:MASTER%做了%ARGS%。
	PRINTL 
	;PRINTFORML －玛丽－
	PRINTFORML 「现在穿着的是……%CLOCOLOR(CSTR:胖次, "形容詞")%%PANTIES(TARGET, "種類")%%TEXTR("＿/哦/、呜")%……」
	;換装の導線を引いておく。一回見るとその後は50％の確率になる
	IF CEVENT("換装：玛丽") == 0 || (CEVENT("換装：玛丽") && RAND:3 == 0)
		PRINTFORMW 「如果可以的话……请%CNAME("二人称")%假装和人家交易的样子，告诉我您喜欢的内褲款式吧……」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「是%CNAME("一人称")%喜欢的款式……合%CNAME("二人称")%的口味吧」
	ELSE
		PRINTFORMW 「……%TEXTR("只要是/如果不是")%%CNAME("二人称")%喜欢的……%TEXTR("请告诉我/我这就去换……")%」
	ENDIF
	;PRINTL 
	;PRINTFORMW 受到%ARGS%后%CALLNAME:TARGET%的反応
	CALL SETFLAG_DAILY, "胖次色確認"
ENDSELECT

