;		STR:選択肢 += "陰蒂環鑑賞/"
ENDIF
IF TALENT:恋慕
	;性処理合意がない部員がいる
	SIF CHARA_NUM("性処理合意没有") > 0
		RETURN 0
	;調教者の施虐属性が必要
