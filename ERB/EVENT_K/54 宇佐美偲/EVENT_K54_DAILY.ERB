;-------------------------------------------------
;各種打招呼
;注意！ここのセリフは基本的に颜绘が付きます！！
;颜绘に変化を付けたい場合にはセリフの前でEMOTION_PLUSを用いる事で変えられます。
;例）恥じらった顔にさせたい場合には CALL EMOTION_PLUS, "害羞", TARGET
;-------------------------------------------------
@KOJO_GREETING_K54, ARGS
#DIM MEMO_LINECOUNT
;イベント発生中の角色
#DIM ACTOR
;イベント発生中の角色の默认のCALLNAME
#DIMS CALLNAME_ACTOR

MEMO_LINECOUNT = LINECOUNT

SELECTCASE ARGS
CASE "朝拘束"
	PRINTFORMW 「啊～啊、醒了啊……嘛、数一数天花板上的污渍吧、很快就结束了」
;朝のＨイベントでのセリフ。下の"打招呼"だけ書いてあれば十分だと思います
;ここでCALL SETFLAG, "地の文スキップ"すると地の文、経験表示、本来なら続いて表示される下のCASE "打招呼"の台詞、を全てすっ飛ばせます(上級者向け)
;詳しくは@EVENT_NEWDAYの注釈などを見てください
CASE "朝袭"
	SELECTCASE CSTR:朝袭
	CASE "朝逆正常位"
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「啊、已经醒了啊…」
				PRINTFORMW 「本来想趁你睡着的时候做完的、既然醒了、那就没関系了、」
				PRINTFORMW %CALLNAME:TARGET%这样说着、開始更加%TEXTR("粗暴/毫不留情")%地摆动腰部
			CASE 1
				PRINTFORMW 「哎呀、醒来了呢…」
				PRINTL 
				CALL PRINT_SELECT, "希望你不要趁睡着的时候擅自做这种事…"
				IF RESULT == 0
					PRINTFORMW 「哎？明明是赖床不起的%CNAME("二人称")%不对吧、我都湿漉漉了还故意把可爱的睡颜展示给我看」
					PRINTFORMW 「而且肉棒都硬挺挺了、不用的话也太失礼了、所以才不得已交尾的哦」
				ENDIF
			ENDSELECT
	CASE "朝舐陰"
	CASE "朝足交"

	CASE "朝の新妻PLAY"
			CALL SET_SHIRT, "工作围裙"
			CALL EMOTION_PLUS, "重置/微笑２/赤面２/对话框爱心"
			SELECTCASE RAND:2
				CASE 0
					CALL PRINT_STRW, @"「あんっ_H_もう、料理中は危ないからダメですよ」"
					CALL PRINT_STRW, @"「あっ_H_激烈地しちゃ、んっ_HH_ダメっなのni↘、んっん」"
					CALL PRINT_STRW, @"「はー、いっぱいだせて気持ち良くなれましかたか_H_」"
				CASE 1
					PRINTFORMW 「早饭吃米饭和玉子烧可以吧？」
					PRINTFORMW 在厨房做饭的%CALLNAME:TARGET%只围着一条围裙摆出挑逗的姿势
					CALL PRINT_STRW, @"「%CNAME("二人称")%どうしたんですか、冷めちゃいますよ_BH_」"
					PRINTFORML
					PRINTFORMW 餐桌上一个盘子都没摆……。也就是说就是这么回事吧…
					CALL PRINT_STRW, @"「朝から元気ですね_BH_出し終わってから、一緒に食べましょうか_BBHH_」"
			ENDSELECT
			
	CASE "朝乳交"

	CASE "朝面部騎乗"
		
	CASE "朝騎乗位"
		IF EXP_GAIN("射精経験", PLAYER)
			CALL PRINT_STRW, @"「あ！、早上好うございまーす_H_」"
			CALL PRINT_STRW, @"「我慢できなかったので_HH_　%TEXTR("襲って/勝手に")%交尾してまーす_BH_　好きな時に出してくださ～ぅ、おっ……_HH_」"
		ELSE
			CALL PRINT_STRW, @"「%TEXTR("あぅ/おぅ")%っ_H_　う、うぅ、あっ_H_」"
			CALL PRINT_STRW,  "「あ……っ_H_　ちんちん_H_　すごいよぉ…_BH_」"
		ENDIF

	CASE "朝接吻"

	CASE "朝添い寝"
			CALL EMOTION_PLUS, "重置/微笑/红晕/对话框爱心"
			PRINTFORMW 「嗯、果然被%CNAME("二人称")%抱在怀里感觉很舒服啊」
			PRINTFORMW 「今天的早晨真美好」
	CASE "朝口交", "朝六九式"

	ENDSELECT
;朝のＨイベント終了後にする打招呼
CASE "打招呼"
	SELECTCASE CSTR:朝袭
	CASE "朝口交"
		PRINTFORMW 「我自顾自開始吸的、不用管我…」
	CASE "朝騎乗位"
		CALL EMOTION_PLUS, "重置/微笑/赤面２/对话框爱心"
		CALL PRINT_STRW, @"「これなら%CNAME("二人称")%の%TEXTR("赤酱/兒童")%_H_　ちゃーんと孕めそう……_H_」"
	ENDSELECT

	;何か発言してたらここまで
	SIF LINECOUNT > MEMO_LINECOUNT
		RETURN 1

	IF COND("体育")
		PRINTFORMW 
	ELSE
		PRINTFORMW 「早上好呀前辈」
		PRINTFORMW 「可爱的后辈来叫你起床了、快一点起床吧」
	ENDIF
CASE "登校"
	IF DAYEV("試験当日")
		CALL EMOTION_PLUS, "重置/微笑/4/对话框兴奋/挎包"
		PRINTFORMW 「早上好！今天可是定期考试、好好复习了吗？」
		PRINTFORMW 「%CNAME("一人称")%可是超级用功复习了、肯定能拿一百分！」
		PRINTFORMW 明明是考试的日子%NAME:TARGET%却蹦蹦跳跳地跑向教室
	ELSEIF DAYEV("試験返却日")
		CALL EMOTION_PLUS, "重置/ガビーン/对话框乱/挎包"
		PRINTFORMW 「早～安～啊～完全没手感啦～」
		PRINTFORMW 「哈啊～～、这次肯定完蛋啦～」
		PRINTFORMW 仅仅因为可能考砸、%NAME:TARGET%就摆出一副世界即将末日般的表情蔫蔫地走着
	ELSEIF COND("朝袭相手")
		CALL PRINT_STRW, @"「あっ…、_H_改めて早上好…」"
		CALL PRINT_STRW, @"「じゃ、また部活で…_H_」"
	ELSEIF COND("体育")

	ELSEIF COND("水泳")
		CALL EMOTION_PLUS, "大口/通常眉/对话框兴奋/挎包"
		PRINTFORMW 「呜哇～、游泳池！游泳池！」
		PRINTFORMW 看起来正处于极度兴奋的状态。
	ELSE

	ENDIF
;この角色と一緒に部室に入った際に誰も他にいない場合
CASE "一番乗り"
	SELECTCASE RAND:2
		CASE 0
			PRINTFORMW 「耶～！我是第一名！！」
		CASE 1
			PRINTFORMW 「啊嘞、居然没有人啊……感觉有点寂寞呢」
	ENDSELECT
CASE "ただいま"
		PRINTFORMW 「我回来啦！晚饭吃什么呀！」
CASE "既に入室"
	;家で出迎えてくれる時
	IF COND("夜")
			CALL EMOTION_PLUS, "温馨/微笑３/紅潮２/对话框爱心/布"		
		IF TALENT:恋慕 && RAND:2 == 0
			PRINTFORML 「啊……欢迎回来…」
			PRINTFORML 「那个…、有空的话、要来交尾吗？」
		ELSE
			PRINTFORMW 「你回来啦~」
			PRINTFORMW 「我放好洗澡水了、要一起泡吗？」
		ENDIF
	ELSEIF COND("昼")
		IF RAND:2 == 0
			PRINTFORMW 「喂！我先在这里休息啦」
			PRINTFORMW 「想交尾的话随时叫我哦」
		ELSE
			PRINTFORMW 「那里已经很湿润了、想要插入的话就叫我哦」
		ENDIF
	ENDIF

CASE "入室打招呼"
	IF CFLAG:呼び出された
		PRINTFORMW 「您好～、找%CNAME("一人称")%有什么事吗？」
	;你が現在的partnerにＨ的悪戯をしている最中に入室した（partnerへの呼びかけはCNAME("partner")で出来る）
	ELSEIF COND("Ｈ的いちゃつき中", MASTER)
		PRINTFORMW 「哇～、待会儿也请陪%CNAME("一人称")%玩嘛」
	ELSE
		PRINTFORMW 「啊～、太狡猾了！%CNAME("一人称")%也相交尾啦～」
	ENDIF
;部屋にいる他の人から打招呼を返される打招呼。WAITの使用は一回が望ましい
CASE "簡易入室打招呼"
	;遅れた時のセリフ（既に部員の４分の３が集合済）
	IF CHARA_NUM("入室打招呼時の室内人数") >= CHARANUM*3/4 && RAND:3 == 0
		PRINTFORMW 「呜哇！大家都到了！抱歉我迟到了～」
	ELSEIF CFLAG:呼び出された
		PRINTFORMW 「您～好」
	ELSE
		PRINTFORMW 「今天也要亲热吗～？」
	ENDIF
;簡易入室打招呼に対する返し。WAITの使用は一回が望ましい
;誰が入室してきた人はCOND("入室打招呼中")がONなのでFIND_COND("入室打招呼中")で検索可能
;また、入ってきた人数はCHARA_NUM("入室打招呼中")で調べられる
CASE "打招呼返し"
	;打招呼してきた人の中から一人選ぶ
	ACTOR = FIND_COND("入室打招呼中")
	;選ばれた角色の默认のCALLNAME。この角色への呼びかけはCNAME(CALLNAME_ACTOR) で出来る
	CALLNAME_ACTOR = %CSVCALLNAME(NO:ACTOR)%

	;ここでは括弧に『』を使う

	;打招呼してきた人に老师が混じっている
	IF FIND_COND("教員", "入室打招呼中")
		PRINTFORMW （诶…这个社团、居然会有老师来吗！？）
		PRINTFORMW %NAME:TARGET%似乎正对什么感到震惊
	;相手が現れるのが遅かった（既に部員の４分の３が集合済）
	ELSEIF CHARA_NUM("入室打招呼時の室内人数") >= CHARANUM*3/4 && RAND:3 == 0
		PRINTFORMW 「我就先在这里休息啦～」
	ELSE
		PRINTFORMW 「啊嘞、难道是我来太早了吗…」
	ENDIF

CASE "居間に現れた"
	IF CFLAG:呼び出された
		PRINTFORMW 「晚上就不能让人家悠闲点嘛～」
		PRINTFORMW 「没办法只好来见你啦」
	;一度居間から別の場所に行って、居間に帰って来た時
	ELSEIF CMOVE("居間")
		PRINTFORMW 「真是的～、干嘛啦？%CNAME("一人称")%想睡觉了、」
	ELSE
		CALL EMOTION_PLUS, "温馨/叹气/对话框ねぼけ"
		PRINTFORMW 「呼啊～～、好困…」
	ENDIF
CASE "抜け出された"
		CALL EMOTION_PLUS, "困扰眉/涙目〇〇/左〇〇/对话框乱/一文字"
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「啊、……走掉了……」
				PRINTFORMW %CALLNAME:TARGET%垂頭丧气地耷拉着肩膀
			CASE 1
				PRINTFORMW 「哎～人家难得过来却被晾在一边…」
				PRINTFORMW 「光这样还不够、居然还和别的女孩子缠绵…哈啊～」
		ENDSELECT
CASE "便当"
		PRINTFORMW 「味道怎么样？那个……人家很努力准备的、夸夸我嘛」
;同じ部屋にいる他の人がＨを開始した際のセリフです
CASE "他の人がＨ開始"
		CALL EMOTION_PLUS, "号泣２/ω/斜眉"
		PRINTFORMW 「也考虑一下被吊着胃口的这边的心情嘛～！」
ENDSELECT

;-------------------------------------------------
;メイン画面での台詞。いわゆる一言イベント強化版
;ちなみに画面随机属性しても同じセリフを喋ります
;選択肢に挟まれた場所で出力するのでWAITの使用は禁止
;动画ーションの関係上、１ターンに何度も呼ばれたりするのでフラグ操作をする場合には
;IF CFLAG:KOJO_DAILY済 == 0
;で分岐させるのが良いでしょう
;-------------------------------------------------
@KOJO_DAILY_K54, ARGS
#DIM MEMO_LINECOUNT
MEMO_LINECOUNT = LINECOUNT

SELECTCASE ARGS
;初回のセリフ
CASE "初回台詞"
		CALL EMOTEFACE, "重置/小口/赤面２"
		PRINTFORML 「呜哇～、原来您让这里好几个人都怀上了啊、好厉害」
CASE "浑身是汗"
	IF RAND:2 == 0
		PRINTFORML 「呼诶～、好热啊～、都要受不了了」
	ELSE
		CALL EMOTEFACE, "重置/温馨/婴儿红晕/对话框兴奋/冰"
		PRINTFORML 「冰淇淋超赞～、%CNAME("二人称")%也要来一根吗？」
	ENDIF
CASE "刚睡醒"
	IF CHOSE_DEVENT("睡眠姦Ｖ中出し")
		CALL EMOTEFACE, "重置/害羞/对话框困倦///"
		CALL PRINT_STRL, @"「………那个啊_／／／_虽然没说不可以做的我也有责任啦」"
		PRINTFORML 「在我不知道的时候进展到这种程度我也会困扰的、所以还是请在清醒的时候出手吧」
		CALL PRINT_STRL, @"「不过、很舒服哦……_H__／／／_」"
	ELSE
		PRINTFORML 「嗯嗯～、早安。我去洗一把脸」
		PRINTFORML 宇佐美伸着懒腰走向洗漱台
	ENDIF
CASE "Cosplay中"
	PRINTFORML 「让我穿成这样就没有什么企图吗？」
CASE "点心の感想"
	;今日の点心を用意したのは自分
	IF COND("点心当番")
		PRINTFORML 「怎么样？苹果切得很漂亮吧？」
		PRINTFORML 「快夸我！快夸我！」
	;今日の点心は誰かの亲手自制
	ELSEIF COND("亲手自制点心")
		;今日の点心当番の人の亲手自制を初めて食べた
		IF DEVENT(@"%TEXTS("点心当番")%の亲手自制") == 0
			;点心当番が[料理擅長]
			IF TALENT:恋慕
				PRINTFORML 「非常好吃哦这个点心！下次我们一起」
				CALL PRINT_STRL, @"「做这个点心吧_H__BH_」"
			ELSE
				CALL EMOTEFACE, "重置/对话框開心/斜眉/红晕/半開３"
				PRINTFORML 「嗯～、嚼嚼。」
				PRINTFORML 「好好次～」
			ENDIF
		ELSE
			PRINTFORML 
		ENDIF
	;点心が亲手自制でない
	ELSE
		CALL EMOTEFACE, "重置/对话框開心/斜眉/红晕/半開３"
		PRINTFORML 「嗯～、嚼嚼。」
		PRINTFORML 「好好次～」
	ENDIF
;沉眠著
CASE "睡眠"
	;梦话
	CALL KOJO_SLEEP_K54
	;梦话用の汎用地の文呼出
	CALL DAILY_MESSAGE, "梦话"
ENDSELECT

;何か発言してたらここまで
SIF LINECOUNT > MEMO_LINECOUNT
	RETURN 1

;前回指令対応台詞
SELECTCASE CONDS("直前行動")
CASE "愛の告白"
	PRINTFORML 「虽然要再确认一次、但真的可以吗！？」
	PRINTFORML 看来正如%NAME:TARGET%所说的那样、相处起来确实不容易
CASE "约会的约定"
	CALL EMOTEFACE, "重置/へ字２/紅潮２/闭眼２/对话框開心"
	PRINTFORML 「可以哦、总是让你陪我交尾、这是谢礼啦」
;これは悪魔や天使や驱魔人のみ
CASE "契約成立"
	PRINTFORML 「不是、%CNAME("一人称")%可不像弗理希艾尔小姐那样」
	PRINTFORMW 「灵魂交易什么的我可不会啊、您还是另寻高明吧」
;你にお願いされて、自分の力で巨根になってあげた(悪魔と天使のみ)
CASE "巨根化契約成立"
	PRINTFORML 
CASE "短小化契約成立"
	PRINTFORML 
CASE "摆脱"
	PRINTFORML 「在会被看到的地方做不该做的事啊…」
	PRINTFORML 「要去哪里？干脆直接去爱情旅馆算了…」
;你と一緒に、主人公的房間に移動した
CASE "主人公的房間に連れ込まれた"
	PRINTFORML 「嘿～、比想象中整洁嘛」
	PRINTFORML 「那接下来要做什么?」
;你と一緒に、partner的房間に移動した
CASE "自室に招待"
	PRINTFORML 「虽然打扫得不太彻底、不过请随意放松」
;partnerが既に居る部屋に、你が移動した
CASE "自室に訪問された"
	;指导者を伴っている場合
	IF FIND_COND("現在存在", "助手")
		PRINTFORML 「%CNAME("助手")%也很辛苦呢～、要是应付不来%CNAME("二人称")%的话、」
		PRINTFORML 「随时跟我说、%CNAME("一人称")%可以代劳哦！」
	ELSE
		PRINTFORML 「呜哇啊～吓我一跳～」
		PRINTFORML 「来之前好歹用手机通知一下嘛」
	ENDIF
CASE "指导者部屋訪問"
	PRINTFORML 
;自宅移動の後に你に連れられて居間に回来了場合など。優先度は低いです
CASE "帰還"
	PRINTFORML 「哇、回来了！」
CASE "オナバレ"
	PRINTFORML 「啊……请忘掉吧………」
	PRINTFORML 用几乎要消失的声音嗫嚅着関上了門
CASE "露脐装超短裙胖次チラ"
	IF TALENT:恋慕
		CALL EMOTEFACE,"重置/斜眉/对话框爱心/紅潮/ڡ"
		PRINTFORML 「呋呋、故意让你看的哦。察觉到了吗」
		PRINTFORML 「怎么样？兴奋起来了吗？」
		CALL PRINT_STRL, @"「这边可是毫不遮掩地展示着、前辈那边也请坦诚相待吧…_H_」"
	ELSE
		CALL EMOTEFACE,"重置/こまり眉/对话框！？/半開２"
		PRINTFORML 「嗯？怎么啦、表情怪怪的…」
		PRINTFORML 「难道我脸上沾了什么东西吗！？」
		PRINTFORML 用手啪啪地拍着脸、揉了揉检查有没有异常
		PRINTFORML 似乎完全没有注意到你的视线方向
	ENDIF
CASE "低腰臀圍"
	PRINTFORML 
CASE "掀起裙子"
		CALL EMOTEFACE,"重置/笑顔２/对话框爱心/赤面２"
		PRINTFORML 「真是的～、H～」
		PRINTFORML %CALLNAME:TARGET%的眼神中带着几分妖艳
CASE "撫摸股間"
		CALL EMOTEFACE, "重置/赤面/ヮ３"
		PRINTFORML 「摸了人家让人家兴奋起来的话、可要负~责~到~底~哦」
		PRINTFORML %CALLNAME:TARGET%用双臂按住你那只在股间作弄的手，在你耳边轻声低语
CASE "检查内褲"
	IF COND("合意：检查内褲")
		PRINTFORML 「不过啊、%CNAME("二人称")%就这么想看内褲吗～」
		PRINTFORML 「真是变态呢、那作为回礼请给我注入子种吧」
		PRINTFORML 虽然嘴上碎碎念着、但还是顺从地把裙摆撩高方便你观察
	ENDIF
CASE "检查阴部"
	IF COND("合意：检查阴部")
		PRINTFORML 「这里已经打理干净了所以请快点把肉棒插进来吧…」
	ENDIF
CASE "拜托処理性欲"
	IF RAND:2 == 0
		PRINTFORML 「呐、你看这个嘛～」
		PRINTFORML 「刚刚射出来的、热乎乎的精液把内褲都弄脏了」
		CALL EMOTEFACE, "重置/赤面/胖次花绳变化/通常眉/笑顔３"
	ELSE
		PRINTFORML 「射进里面的量太多、都溢出来把内褲弄脏了…」
		PRINTFORML 「你看看这个、光是溢出来的就有这～么多精液呢」
		CALL EMOTEFACE, "重置/赤面/胖次花绳变化/通常眉/笑顔３"
	ENDIF
CASE "进行性処理"
	PRINTFORML 「那么、我这边还要继续工作、就请其他女孩来陪你吧」
