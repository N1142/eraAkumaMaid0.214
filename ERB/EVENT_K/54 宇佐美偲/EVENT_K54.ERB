;-------------------------------------------------
;口上テンプレート
;	[发情白兔]　宇佐美　偲
;		製作者　いか烏冬面
;-------------------------------------------------
;-------------------------------------------------
;
;　〇　コンセプト
;　　　　倫理観を超越した妊娠欲求マシマシの女の子
;
;		（エンドコンテンツ的な要素を孕んだ子が欲しいなと思って勧誘条件が厳しめ）
;	初期
;	孕むためなら文字街道なんでもするが、Hなことはイケナイことと認識している
;	大事なことは妊娠のために”交尾”を求めているのであって”エロいこと”はしたくない、
;	ただし、円滑な交尾のためならエロいことも容認するようになる。
;
;	中期(目安として:屈服刻印１,2程度)
;	慣れてくると徐々にエロいこと自体にも興味を持つようになってくる。
;	次第に”交尾”と”Hなこと”の境界が曖昧になるようになる
;	你のちんちんが「なんか良いな」と思い始める。同時にそれ以外のちんちんを「なんとなく嫌」
;	という認識を持つようになる
;	
;	末期（目安として:屈服刻印３,恋慕,相思相愛）
;	”交尾”＝”Hなこと”という認識に完全に変化する。ただし、「妊娠するため」という体で
;	你と関係を持ったため表面上は”Hなこと”を仕方なく行っている風に行動する。
;
;	一貫して変わらない要素
;	性格は自意識過剰で独占欲強め、
;	目的は妊娠することで有、別に兒童が欲しいわけでもないし、育てたいわけでもない。
;	なんなら出産することの障壁になり得るなら積極的に排除しようとする。
;	但是、そのような存在は周囲から異端だと認識されることを自覚できているため
;	平気で嘘を付くし、兒童が生まれると泣いて喜ぶふりをする。　怖いね
;	
;
;　〇	口調に関する設定
;	過度な敬語は使わないが、です・ます等の丁寧語は多様する。
;	心を許した相手や、余裕がない時は丁寧語を使うのも忘れる。
;	Hなことを求められると恥ずかしがる（重要）:もう死に設定化してるな/2023922
;
;
;　〇　裏設定（今見返すと、この設定いらないなと思いました、圆圈）
;	生れについて:元々彼女の母親は人类だったが、とある病気の治療法の発見の延命
;	という目的で医者である彼女の叔父によって後天的に獣人(兎)变成了。
;	当時母胎にいた宇佐美もその影響を強く受けたため、獣人になってしまった。
;	
;	幼少期について:彼女の母親の治療法はついぞ見つからず、他界する。
;	父親は分からず、身近の血縁であった叔父に引き取られる。
;	叔父は獣人であることの悪影響を鑑み、彼女を普通の人类に戻そうとするが、
;	いかなる外科的アプローチが全て失敗に終わる。
;	様々な方法を模索し、最終的にとある高位の悪魔と契約する。
;	
;	悪魔が述べた宇佐美の状態
;	「この娘は母親からの"どんな形でもいいからこの子を産みたい"という願いが
;	"何が何でも兒童を産む"という呪いに転じてしまっており、このまま成長すれば
;	おぞましい数の兒童を積極的に産みおとすことになる。そして最悪なことにこの呪いは
;	子から子へと伝播する。」←これが[受胎呪詛]
;
;	叔父は呪いの緩和とそもそも妊娠不会うにするように要求、これが[难以妊娠Ⅱ]
;	となる。なお、この際叔父は代償として左腕が肘から下と足の指全部、寿命の３分の１を失う。
;
;	母親とは直接会ってないが、年を取るごとにその年齢に合わせたホームビデオのようなものを用意しており、
;	顔やおおまかな仕草とかは知っている。
;
;角色追加の手順（必読！）
;１：EVENT_K54_名前.ERBとEVENT_K54_SHOP.ERBとEVENT_K54_DAILY.ERBとCHARAK54.csvのファイル名と内部のK54を角色番号に変更し、名前部分を角色名にする

;２：変更後のERBファイルをEVENT_Kフォルダに、CHARAK54.csvをCSVフォルダに入れる

;３：他の角色を参考にCHARAK54.csv内部の初期設定を記述する
;番号,名前,呼び名,基礎は必ず全部埋めましょう。CSTRも可能な限り埋めた方が良いです
;CSTR,胖次～飾品は初期衣装なので書かないと初期が全裸です

;４：このファイル内にある、@EVENT_PROFILE_K54を記述する
;CASE "勧誘直後"は別に無くても構いません
;CASE "勧誘前"と"紹介文"は有った方が良いです

;５：CALL_NAME.ERB内の
;CASE K54
;	STR:基本呼び名 = %CNAME_K54(ARGS)%
;の２行先頭の ; を削除する。

;６：以上で角色追加の準備が整います
;本編の日替わり領帯ミングでこんな人が居ますよ～って紹介するイベントが有些ますが、それを見ないでもメイン画面[301]で勧誘できます

;７：あとはERBファイルに書けば書くだけ喋るようになります

;-------------------------------------------------
;呼び名の設定。"_"の右にふりがなを書く。
;-------------------------------------------------
@CNAME_K54, ARGS
#FUNCTIONS
;名前を呼ぶ相手の角色番号の代入に使う
#DIM ACTOR

VARSET LOCALS

SELECTCASE ARGS
CASE "一人称"
	LOCALS = 我_我
CASE "二人称"
	;相手が主人
	IF PLAYER == MASTER
		LOCALS = 前輩_前輩
	;相手が主人ではない
	ELSE
		LOCALS = 前輩_前輩
	ENDIF
;この下は三人称。
CASE "主人"
	LOCALS = 您_您
CASEELSE
	;名前を呼ぶ相手の角色番号をACTORに代入する
	SELECTCASE ARGS
	;相手が助手
	CASE "助手"
		ACTOR = ASSI
	;ここにはARGSに角色のCALLNAMEが入ったりしている場合(ARGS == "弗理希艾尔" など)に来る
	CASEELSE
		ACTOR = FIND_NO(ARGS)
	ENDSELECT

	;相手が教員
	IF COND("教員", ACTOR)
		LOCALS = %CALLNAME:ACTOR%老师_%CALLNAME:ACTOR%老师

	;自分も相手も学生なら学年比較
	ELSEIF COND("学生") && COND("学生", ACTOR)
		;相手が同学年
		IF COND("学年") == COND("学年", ACTOR)
			LOCALS = %CALLNAME:ACTOR%_%CSTR:ACTOR:ふりがな%
		;相手が下の学年
		ELSEIF COND("学年") > COND("学年", ACTOR)
			IF TALENT:ACTOR:男性
				LOCALS = %CALLNAME:ACTOR%君_%CALLNAME:ACTOR%君
			ELSE
				LOCALS = %CALLNAME:ACTOR%酱_%CALLNAME:ACTOR%酱
			ENDIF
		;相手が上級生
		ELSE
			LOCALS = %CALLNAME:ACTOR%前輩_%CSTR:ACTOR:ふりがな%前輩
		ENDIF

	;それ以外
	ELSE
		LOCALS = %CALLNAME:ACTOR%桑_%CALLNAME:ACTOR%桑
	ENDIF
ENDSELECT
RETURNF LOCALS

